# ===========================================
# Split-It Production Environment Variables
# ===========================================
# Copy this file to deploy/env/.env.production and fill in your values
# This file is used by docker-compose.production.yml
#
# Usage: docker-compose -f deploy/docker/docker-compose.production.yml --env-file deploy/env/.env.production up -d

# ===========================================
# Database Configuration
# ===========================================
# MongoDB Atlas connection string (recommended for production)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/splitit?retryWrites=true&w=majority

# ===========================================
# Redis Configuration
# ===========================================
# Docker Redis (default in docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================
# JWT & Security
# ===========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_64_characters_long

# JWT token expiration
JWT_EXPIRES_IN=7d

# ===========================================
# Server Configuration
# ===========================================
NODE_ENV=production
PORT=5000

# Your domain (used for CORS and cookies)
SERVER_URL=https://xxxxxxxx
CLIENT_URL=https://xxxxxxxx

# ===========================================
# Google OAuth
# ===========================================
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===========================================
# Email Configuration (Nodemailer)
# ===========================================
# Using Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=xxxxxxxxxxxxxxx@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=xxxxxxxxxxxxxxx@gmail.com

# ===========================================
# Push Notifications (Web Push / VAPID)
# ===========================================
# Generate with: npx web-push generate-vapid-keys
# IMPORTANT: Use the SAME public key for both frontend and backend
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:xxxxxxxxxxx@gmail.com

# ===========================================
# Frontend Environment Variables
# ===========================================
# These are used during the React build process
REACT_APP_API_URL=https://xxxxxxxx/api
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
REACT_APP_SOCKET_URL=https://xxxxxxx
REACT_APP_VAPID_PUBLIC_KEY=your_vapid_public_key_here
