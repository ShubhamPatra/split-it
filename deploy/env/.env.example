# ===========================================
# Split-It Frontend Environment Variables
# ===========================================
# Copy this file to the project root as .env and fill in your actual values
# See deploy/docs/ for detailed setup instructions
#
# Location: This file should be copied to the project root (../..)
# Usage: cp deploy/env/.env.example ../../.env

# ===========================================
# API Configuration
# ===========================================
# Backend API URL
REACT_APP_API_URL=http://localhost:5000/api

# ===========================================
# Google OAuth
# ===========================================
# Google OAuth Client ID (same as backend)
# Get this from Google Cloud Console: https://console.cloud.google.com/
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ===========================================
# Socket.IO Configuration (Optional)
# ===========================================
# Socket.IO URL (defaults to API URL base if not set)
# REACT_APP_SOCKET_URL=http://localhost:5000

# ===========================================
# Feature Flags (Optional)
# ===========================================
# Enable/disable push notifications
# REACT_APP_ENABLE_PUSH_NOTIFICATIONS=true

# Enable/disable analytics
# REACT_APP_ENABLE_ANALYTICS=false

# ===========================================
# Push Notifications (Optional)
# ===========================================
# VAPID Public Key for web push notifications
# Generate using: npx web-push generate-vapid-keys
# Use the SAME public key as backend VAPID_PUBLIC_KEY
# REACT_APP_VAPID_PUBLIC_KEY=your_vapid_public_key
