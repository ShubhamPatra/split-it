# Production Environment Variables for React Build
# These are embedded at BUILD TIME, not runtime

# API URL (your production backend)
REACT_APP_API_URL=https://split-it.live/api

# Google OAuth Client ID
REACT_APP_GOOGLE_CLIENT_ID=599819727732-7jnsnkrj0s0k73upataf45445m2l1ja9.apps.googleusercontent.com

# Socket.IO URL
REACT_APP_SOCKET_URL=https://split-it.live

# VAPID Public Key for Push Notifications
# Generate with: npx web-push generate-vapid-keys
# Copy only the PUBLIC key here (private key goes on server only)
REACT_APP_VAPID_PUBLIC_KEY=

# Disable source maps in production
GENERATE_SOURCEMAP=false
