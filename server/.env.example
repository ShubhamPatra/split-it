# Backend Environment Variables
# Copy this file to .env and fill in your actual values
# See SETUP.md for detailed instructions

# =================================
# SERVER CONFIGURATION
# =================================
PORT=5000
NODE_ENV=development

# =================================
# DATABASE
# =================================
# MongoDB Atlas (cloud)
# Get your connection string from MongoDB Atlas: https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/splitit?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/splitit?retryWrites=true&w=majority

# OR MongoDB Local
# MONGODB_URI=mongodb://localhost:27017/splitit

# =================================
# AUTHENTICATION
# =================================
# Generate a secure random string (at least 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_use_random_string

# JWT token expiration (default: 7d)
JWT_EXPIRES_IN=7d

# =================================
# URLS
# =================================
SERVER_URL=https://your-api.vercel.app
CLIENT_URL=https://shubhampatra.github.io/split-it

# (Optional) Additional origins for CORS - comma-separated list
# Leave empty for single origin (uses CLIENT_URL only)
# Example: ALLOWED_ORIGINS=https://admin.example.com,https://staging.example.com
ALLOWED_ORIGINS=

# =================================
# GOOGLE OAUTH (Optional)
# =================================
# Get these from Google Cloud Console: https://console.cloud.google.com/
# See SETUP.md for step-by-step setup instructions
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =================================
# EMAIL CONFIGURATION (For Password Reset & Notifications)
# =================================
# Gmail SMTP Configuration:
# 1. Enable 2-Factor Authentication on your Google Account (https://myaccount.google.com/security)
# 2. Generate an App Password (https://myaccount.google.com/apppasswords)
# 3. Copy the 16-character password and paste it below as SMTP_PASS
# 4. Set SMTP_USER to your full Gmail address (including @gmail.com)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM=your_email@gmail.com

# (Optional) Force TLS mode - leave unset for automatic detection based on port
# Port 465 uses implicit TLS (secure: true), other ports use STARTTLS (secure: false)
# SMTP_SECURE=true

# =================================
# PUSH NOTIFICATIONS (Optional)
# =================================
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:your_email@example.com

# =================================
# REDIS (Optional - For Horizontal Scaling)
# =================================
# Redis is NOT required for single-instance deployments
# Only configure if running multiple server instances behind a load balancer
# Socket.IO will use Redis adapter for cross-instance communication
# REDIS_URL=redis://localhost:6379

# =================================
# SERVERLESS / VERCEL MODE
# =================================
# Realtime mode: socketio (legacy) or polling (Vercel-friendly)
REALTIME_PROVIDER=polling

# Enable in-process scheduler only for long-lived servers
ENABLE_IN_PROCESS_SCHEDULER=false

# Enable balance service timers only for long-lived servers
ENABLE_PERSISTENT_TIMERS=false

# Shared secret for external cron triggers (Vercel Cron / scheduler)
# CRON_SECRET=generate_a_random_secret

# =================================
# FILE STORAGE
# =================================
# Cloudinary credentials for receipt uploads
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# OCR processing mode: inline (legacy) or async (Vercel-friendly)
OCR_PROCESSING_MODE=async

# =================================
# FILE UPLOADS (Optional)
# =================================
# Directory for file uploads (receipts, etc.)
# Default: ./uploads/receipts
# UPLOAD_DIR=/path/to/uploads

# =================================
# INVITATIONS (Optional)
# =================================
# Default invite link expiry in hours (default: 168 = 7 days)
# INVITE_EXPIRY_HOURS=168

# Maximum number of emails per invite batch (default: 50)
# MAX_INVITE_EMAILS=50

# =================================
# BRANDING (Optional)
# =================================
# Custom logo URL for email templates
# LOGO_URL=https://your-domain.com/logo.png

# =================================
# DEBUG PORTAL (Optional)
# =================================
# Internal debugging and monitoring dashboard
# WARNING: Only enable in production when actively debugging
# Access via: {SERVER_URL}/{DEBUG_PATH}

# Enable/disable debug portal (default: false)
DEBUG_ENABLED=false

# Secret path for debug portal (use a random, hard-to-guess string)
DEBUG_PATH=/__system/debug-portal-92xA

# Credentials for debug portal access
# Email address for authentication
DEBUG_EMAIL=your-email@example.com

# Strong password (32+ characters recommended)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEBUG_PASSWORD=your-strong-password-here-32-chars-minimum

# =================================
# MIGRATIONS (Internal Use)
# =================================
# Used by migration scripts - typically not needed in .env
# MIGRATION_CREATE_SYSTEM_MESSAGES=false

# =================================
# FRONTEND (Build-time variables)
# =================================
# These are used when building the React frontend (npm run build)
# They get baked into the static files at build time

# API URL for frontend requests
REACT_APP_API_URL=https://your-api.vercel.app

# Google OAuth Client ID (same value as GOOGLE_CLIENT_ID above)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Poll interval for the realtime client when using the polling transport
REACT_APP_REALTIME_POLL_INTERVAL_MS=2000

# VAPID Public Key for push notifications (same value as VAPID_PUBLIC_KEY above)
REACT_APP_VAPID_PUBLIC_KEY=your_vapid_public_key

# =================================
# ARCHITECTURE NOTES
# =================================
# This application uses:
# - node-cron for scheduled jobs (legacy single-instance mode)
# - Socket.IO in-memory by default (legacy single-instance mode)
# - Polling realtime mode for serverless deployments
# - External cron triggers for serverless deployments
# - All background jobs can be moved out of process
#
# For production deployment, see DEPLOYMENT.md
