# Backend Environment Variables
# Copy this file to .env and fill in your actual values
# See SETUP.md for detailed instructions

# =================================
# SERVER CONFIGURATION
# =================================
PORT=5000
NODE_ENV=development

# =================================
# DATABASE
# =================================
# MongoDB Atlas (cloud)
# Get your connection string from MongoDB Atlas: https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/splitit?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/splitit?retryWrites=true&w=majority

# OR MongoDB Local
# MONGODB_URI=mongodb://localhost:27017/splitit

# =================================
# QUEUE BACKEND CONFIGURATION
# =================================
# Queue Backend: 'redis', 'mongodb', or 'auto' (default: auto)
# - redis: Force Redis/BullMQ, fail if unavailable
# - mongodb: Force MongoDB fallback
# - auto: Try Redis first, fall back to MongoDB if unavailable
QUEUE_BACKEND=auto

# MongoDB Queue Settings (when using MongoDB fallback)
# QUEUE_MONGODB_POLL_INTERVAL=2000  # Polling interval in ms
# QUEUE_MONGODB_CONCURRENCY=5  # Max concurrent jobs per worker

# =================================
# REDIS / AWS ELASTICACHE FOR REDIS OSS
# =================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password  # Uncomment if Redis has a password
# REDIS_AUTH_TOKEN=your_elasticache_auth_token  # For ElastiCache with AUTH (Redis OSS)

# Enable/Disable Redis
# REDIS_ENABLED=true

# ElastiCache TLS Configuration (Redis OSS)
# REDIS_TLS=true
# ELASTICACHE_TLS=true
# REDIS_TLS_REJECT_UNAUTHORIZED=true

# ElastiCache Cluster Mode (Redis OSS)
# REDIS_CLUSTER_MODE=true

# Redis Cluster Advanced Settings
# REDIS_CLUSTER_SLOTS_REFRESH_TIMEOUT=15000
# REDIS_CLUSTER_SLOTS_REFRESH_INTERVAL=5000
# REDIS_MAX_RECONNECT_ATTEMPTS=20

# Connection Timeouts (milliseconds) - Adjust for Redis OSS
# Note: Redis OSS may have different connection characteristics than Valkey.
# Increase timeouts if experiencing connection issues during migration.
# REDIS_CONNECT_TIMEOUT=10000
# REDIS_COMMAND_TIMEOUT=5000
# REDIS_KEEP_ALIVE=30000

# Connection Name (for ElastiCache identification in CLIENT LIST)
# REDIS_CONNECTION_NAME=splitit-api

# =================================
# AUTHENTICATION
# =================================
# Generate a secure random string (at least 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_use_random_string

# JWT token expiration
JWT_EXPIRES_IN=7d

# =================================
# URLS
# =================================
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# =================================
# GOOGLE OAUTH (Optional)
# =================================
# Get these from Google Cloud Console: https://console.cloud.google.com/
# See SETUP.md for step-by-step setup instructions
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =================================
# EMAIL CONFIGURATION (For Password Reset & Notifications)
# =================================
# Gmail SMTP Configuration:
# 1. Enable 2-Factor Authentication on your Google Account (https://myaccount.google.com/security)
# 2. Generate an App Password (https://myaccount.google.com/apppasswords)
# 3. Copy the 16-character password and paste it below as SMTP_PASS
# 4. Set SMTP_USER to your full Gmail address (including @gmail.com)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM=your_email@gmail.com

# =================================
# PUSH NOTIFICATIONS (Optional)
# =================================
# Generate VAPID keys: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_SUBJECT=mailto:your_email@example.com
